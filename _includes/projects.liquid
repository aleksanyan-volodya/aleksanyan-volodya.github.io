<div class="col">
  <div class="card h-100 proj-card">
    <div class="proj-card-body">
      <div class="proj-top">
        <span class="proj-num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        {% if project.tags and project.tags.size > 0 %}
          <div class="proj-tags">
            {% for t in project.tags limit: 2 %}<span class="proj-tag">{{ t }}</span>{% endfor %}
          </div>
        {% endif %}
      </div>
      {% assign proj_link = project.url | relative_url %}
      {% if project.redirect %}{% assign proj_link = project.redirect %}{% endif %}
      <a href="{{ proj_link }}" class="proj-title-link"><h2 class="proj-title">{{ project.title }}</h2></a>
      <p class="proj-desc">{{ project.description }}</p>
      {% if project.collaborators %}<div class="proj-with">with <span>{{ project.collaborators }}</span></div>{% endif %}
      <div class="proj-links">
        <a href="{{ proj_link }}" class="proj-link">project ↗</a>
        {% if project.github %}<a href="https://github.com/{{ project.github }}" target="_blank" rel="noopener noreferrer" class="proj-link proj-link--muted">code ↗</a>{% endif %}
      </div>
    </div>
  </div>
</div>