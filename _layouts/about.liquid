---
layout: default
---
<div class="post">
  <header class="post-header">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet" />
    <style>
      .signature-name {
        font-family: "Caveat", cursive;
        font-weight: 700;
        line-height: 0.82;
        margin-bottom: 0.15rem;
      }
      .signature-name .sig-line {
        display: block;
        font-size: clamp(3.5rem, 11vw, 7rem);
        clip-path: inset(0 0 -20% 0);
        animation: sigWipe 1s ease both;
      }
      .signature-name .sig-line--accent { color: var(--global-theme-color); }
      .signature-name .sig-line:nth-child(1) { animation-delay: 0.05s; }
      .signature-name .sig-line:nth-child(2) { animation-delay: 0.45s; }
      @keyframes sigWipe {
        from { clip-path: inset(0 100% -20% 0); }
        to   { clip-path: inset(0 0 -20% 0); }
      }
      .sig-underline {
        height: 6px; width: 150px; border-radius: 4px;
        background: var(--global-theme-color); opacity: 0.55;
        transform-origin: left center;
        animation: sigGrow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.8s both;
        margin: 0.5rem 0 1.1rem;
      }
      @keyframes sigGrow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      @media (prefers-reduced-motion: reduce) {
        .signature-name .sig-line, .sig-underline { animation: none; clip-path: none; transform: none; }
      }
    </style>
    <h1 class="post-title signature-name" aria-label="Volodya Aleksanyan">
      <span class="sig-line">Volodya</span>
      <span class="sig-line sig-line--accent">Aleksanyan</span>
    </h1>
    <div class="sig-underline"></div>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          <div id="profile-photo-trigger">
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
          </div>
          <audio id="profile-audio" src="{{ '/assets/audio/claude_debussy.mp3' | relative_url }}" preload="none"></audio>
          <script>
            (function() {
              var el = document.getElementById('profile-photo-trigger');
              var audio = document.getElementById('profile-audio');
              if (el && audio) {
                el.style.cursor = 'default';
                el.addEventListener('click', function() {
                  if (audio.paused) { audio.play(); } else { audio.pause(); audio.currentTime = 0; }
                });
              }
            })();
          </script>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Letterboxd -->
    {% if site.data.letterboxd and site.data.letterboxd.size > 0 %}
      <div class="letterboxd-section">
        <h2 class="letterboxd-heading">
          recently watched
          <a href="https://letterboxd.com/_volodya_/" target="_blank" rel="noopener noreferrer" class="letterboxd-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="margin-left:6px;vertical-align:middle;opacity:0.6"><path d="M14 3v2H5v14h14v-9h2v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm7 0v6h-2V6.414l-9.293 9.293-1.414-1.414L17.586 5H15V3z"/></svg>
          </a>
        </h2>
        <div class="film-strip">
          {% for film in site.data.letterboxd %}
            <a href="{{ film.link }}" target="_blank" rel="noopener noreferrer" class="film-card">
              {% if film.poster != '' %}
                <img src="{{ film.poster }}" alt="{{ film.title }}" loading="lazy">
              {% else %}
                <div class="film-no-poster">{{ film.title }}</div>
              {% endif %}
              <div class="film-overlay">
                <div class="film-title">{{ film.title }}</div>
                <div class="film-meta">{{ film.year }}{% if film.stars != '' %} · {{ film.stars }}{% endif %}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    <!-- Name variant spellings for search indexing -->
    <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;" aria-hidden="true">
      Volodia Aleksanyan, Volodya Aleksanian, Volodia Aleksanian,
      Volodya Alexanyan, Volodia Alexanyan, Volodya Alexanian, Volodia Alexanian,
      Алексанян Володя, Վոլոդյա Ալեքսանյան
    </span>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Volodya Aleksanyan",
      "alternateName": [
        "Volodya",
        "Aleksanyan",
        "Volodia Aleksanyan",
        "Volodya Aleksanian",
        "Volodia Aleksanian",
        "Volodya Alexanyan",
        "Volodia Alexanyan",
        "Volodya Alexanian",
        "Volodia Alexanian",
        "Алексанян Володя",
        "Վոլոդյա Ալեքսանյան"
      ],
      "url": "https://aleksanyan-volodya.github.io",
      "sameAs": [
        "https://github.com/aleksanyan-volodya",
        "https://www.linkedin.com/in/volodya-aleksanyan/"
      ],
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Université Paris-Saclay"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Université Paris-Saclay"
      },
      "knowsAbout": ["Machine Learning", "Fairness in AI", "Mathematics", "Artificial Intelligence", "Neural Networks"]
    }
    </script>
  </article>
</div>
